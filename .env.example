# ==============================================================================
# TRACELENS INTELLIGENCE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls with Google Search grounding.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="http://localhost:3000"

# PORT: Server listening port (default: 3000).
PORT=3000

# OPTIONAL INTEGRATION KEYS:
# The application features built-in international E.164 parsing (libphonenumber-js),
# public DNS/IP intelligence, and Gemini Search Grounding.
# If these optional external API keys are configured, TraceLens will query them as additional providers:

# NUMVERIFY_API_KEY: Optional telecom provider API key (https://numverify.com)
NUMVERIFY_API_KEY=""

# SERPAPI_API_KEY: Optional raw search provider API key (https://serpapi.com)
SERPAPI_API_KEY=""

# IPINFO_TOKEN: Optional IP geolocation & ASN token (https://ipinfo.io)
IPINFO_TOKEN=""
